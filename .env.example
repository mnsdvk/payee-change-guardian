# Copy to .env for local runs. Never commit real values. On AWS, config comes from the SAM stack and IAM roles.
AWS_REGION=us-east-1
GUARDIAN_TABLE_VENDORS=guardian-vendors
GUARDIAN_TABLE_CASES=guardian-cases
SES_FROM_ADDRESS=guardian@example.com
APPROVER_EMAIL=ap-approver@example.com
WHATSAPP_ORIGINATION_ID=phone-number-id-XXXXXXXX
SMS_ORIGINATION_IDENTITY=+10000000000
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
VERIFY_TIMEOUT_SECONDS=900
